{
  "_comment": "ComfyUI API-format workflow for Wan 2.2 TI2V-5B text-to-video (follows ComfyUI's built-in Wan 2.2 5B template; export your own if node names differ). video_pipeline.py fills prompts/seed/size/frames.",
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Load Diffusion Model"},
        "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Load CLIP"},
        "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "Load VAE"},
        "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
  "4": {"class_type": "ModelSamplingSD3", "_meta": {"title": "ModelSamplingSD3"},
        "inputs": {"shift": 8.0, "model": ["1", 0]}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "CLIP Text Encode (Positive Prompt)"},
        "inputs": {"text": "POSITIVE_PROMPT", "clip": ["2", 0]}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "CLIP Text Encode (Negative Prompt)"},
        "inputs": {"text": "NEGATIVE_PROMPT", "clip": ["2", 0]}},
  "7": {"class_type": "Wan22ImageToVideoLatent", "_meta": {"title": "Wan22ImageToVideoLatent"},
        "inputs": {"width": 1280, "height": 704, "length": 121, "batch_size": 1, "vae": ["3", 0]}},
  "8": {"class_type": "KSampler", "_meta": {"title": "KSampler"},
        "inputs": {"seed": 42, "steps": 30, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0,
                   "model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0]}},
  "9": {"class_type": "VAEDecode", "_meta": {"title": "VAE Decode"},
        "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "CreateVideo", "_meta": {"title": "Create Video"},
         "inputs": {"fps": 24.0, "images": ["9", 0]}},
  "11": {"class_type": "SaveVideo", "_meta": {"title": "Save Video"},
         "inputs": {"filename_prefix": "dd/scene", "format": "mp4", "codec": "h264", "video": ["10", 0]}}
}
