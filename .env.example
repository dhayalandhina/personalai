# copy to ~/.dd/.env (chmod 600). Only fill what you use. Never commit this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
MAIL_USER=
MAIL_APP_PASSWORD=
N8N_URL=http://localhost:5678
N8N_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188
SEARXNG_URL=
DD_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
# Optional cloud brain (free tier, opt-in — your messages go to that provider; local Ollama stays the fallback):
# fill ONE key. Gemini (recommended, biggest free quota): aistudio.google.com/apikey  Groq: console.groq.com  Cerebras: cloud.cerebras.ai  OpenRouter: openrouter.ai
# GROQ_API_KEY=
# GEMINI_API_KEY=
# DD_BRAIN=auto            # auto = first key found (gemini > groq > cerebras > openrouter) | or name one | ollama (force local)
# DD_STT=auto             # auto | mlx (force mlx-whisper on Apple silicon) | faster (faster-whisper only)
# DD_BRAIN_MODEL=          # override the provider's default model id (see examples/dd_loop_ollama.py CLOUD_BRAINS)
DD_TZ=Asia/Kolkata
PIPER_VOICE=en_US-lessac-medium
# DD_TRACK_A_PATTERNS=comma,separated,remote-or-path,markers,for,employer,repos
# cloud server only (cloud_setup.sh writes these): DD_HOST=server  DD_KEEP_ALIVE=-1  DD_NUM_CTX=16384
# DD_HIDE_SKILLS=comma,separated,skills,the,model,should,not,see
